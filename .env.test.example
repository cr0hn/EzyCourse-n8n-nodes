# Copy this file to .env.test and fill in your values
# .env.test is gitignored

# Base URL of your EzyCourse platform (no trailing slash)
BASE_URL=https://your-academy.com

# Access token from EzyCourse Webhook (Data-In) settings
ACCESS_TOKEN=

# Signature token from EzyCourse Webhook (Data-Out) settings
SIGNATURE_TOKEN=

# Webhook URL for trigger integration tests
# Start n8n locally, activate an EzyCourseTrigger workflow, and expose it via ngrok
# Example: https://abc123.ngrok.io/webhook/your-workflow-uuid
WEBHOOK_URL=
